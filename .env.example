# Copy to .env.local (git-ignored) for `npm run dev`, or set these in
# Vercel → Project → Settings → Environment Variables.
# Each webhook URL contains a per-company secret token. Never commit real values.

# v2 console: one Zuper ingestion webhook per source
ZUPER_WEBHOOK_URL_ANGI=
ZUPER_WEBHOOK_URL_THUMBTACK=
ZUPER_WEBHOOK_URL_LSA=
ZUPER_WEBHOOK_URL_META=

# Optional: sign the forwarded body with HMAC-SHA256 (header value "sha256=<hex>")
# ZUPER_WEBHOOK_SIGNING_SECRET_META=
# ZUPER_WEBHOOK_SIGNATURE_HEADER=X-Hub-Signature-256

# Optional: extra static headers per source, as JSON
# ZUPER_WEBHOOK_HEADERS_META={"X-Example-Token":"..."}

# Optional: after a send, fetch the created Lead from the Lead API
# GET {BASE_URL}{PATH} with header {KEY_HEADER}: {KEY}
# ZUPER_LEAD_API_BASE_URL=https://development.zuperpro.com
# ZUPER_LEAD_API_KEY=
# ZUPER_LEAD_API_PATH=/api/v1/leads/{id}
# ZUPER_LEAD_API_KEY_HEADER=x-api-key

# Hosts the proxy will forward browser-entered URLs to (comma-separated domain suffixes)
# ZUPER_ALLOWED_HOSTS=zuperpro.com,zuper.co
